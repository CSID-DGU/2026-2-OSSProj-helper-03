# 이 파일을 Src/.env 로 복사해서 값을 채운다 (.env 는 GitHub 에 올라가지 않음)

# ── 데이터 (저장소 밖 경로) ──
# 화면에서 고른 큐 파일 이름을 이 폴더(하위 폴더 포함)에서 찾는다
HELPER_DATA_DIR=
# 파일 재생 모드로 틀 녹음. 비우면 큐 파일과 같은 폴더의 첫 .wav
HELPER_AUDIO_FILE=

# ── 소리 입력: file(녹음 파일 재생) / mic(마이크) ──
HELPER_INPUT=file            # 화면 시작 패널에서 고르면 그 값이 먼저 (file / mic / text=대사 입력 테스트)
HELPER_MIC_DEVICE=           # 마이크 번호 또는 이름 일부. 비우면 기본 장치 (python -m engine.audio_input --list)

# ── 음성인식 엔진: whisper / google / google_stream / clova_stream ──
HELPER_STT=whisper
HELPER_HINTS=1               # 대본 힌트(현재 큐 + 다음 3큐) 넣기
HELPER_VAD=0                 # 1 이면 조용하고 말소리도 없는 조각은 음성인식에 보내지 않음 (조각 방식만)
HELPER_CHUNK_SEC=3
HELPER_HOP_SEC=1.5           # 조각을 보내는 간격. 3초 조각을 1.5초마다 겹쳐 보내면 1차 데이터에서 가장 정확
                             # (whisper 처리 평균 1초라 따라감. CPU 를 더 쓰므로 송출 노트북이 버거우면 3 으로)
                             # 1초 간격(google 동시 5 + HELPER_ALIGN=accept=72)은 배우 말 → 화면이 2.9 → 2.1초로
                             # 빠르고 평소 흐름 정확도도 높지만(이탈 구간 밖 94~96%), 애드리브 · 반복 · 건너뛰기 뒤에
                             # 크게 헤매서(이탈 구간 안 31~70%) 아직 1.5초를 기본으로 둔다 (10/22 실시간 측정)
HELPER_STT_WORKERS=          # 인식 요청을 동시에 몇 개까지 보낼지. 비우면 엔진 기본값 (whisper 1, google 3)

# faster-whisper (로컬, 키 없음)
WHISPER_MODEL=small
WHISPER_THREADS=4
HF_HOME=                     # 모델 저장 폴더 (비우면 기본 위치에 받음)

# Google Speech-to-Text V2 (google: 3초 조각 / google_stream: 실시간)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_STT_MODEL=chirp_3     # chirp_3 는 LOCATION=us, long 은 global
GOOGLE_STT_LOCATION=us
GOOGLE_STT_HEDGE=1           # 같은 요청을 동시에 몇 번 보낼지. 2 면 먼저 온 답을 써서 인식이 느린 때(요청당 약 2초)
                             # 0.4초쯤 빨라지지만(빠른 때는 0.1초) 인식 비용이 2배. 구글 US 요청 한도가 분당 약 300번이라
                             # 1초 간격 + 2번이면 회차 하나에 분당 120번 (여러 회차를 동시에 돌리면 429 로 막힘)

# CLOVA Speech 실시간 스트리밍 (스트리밍 인식 도메인의 Secret Key)
CLOVA_STREAM_SECRET=

# ── 위치 추적 (보통은 비워 둠) ──
# 추적기 설정 덮어쓰기, 쉼표로 여러 개. 예: ahead=10,lost_window=20  (이름은 engine/aligner.py Aligner 참고)
HELPER_ALIGN=

# ── 회차 기록 ──
# 회차마다 인식 글자 · 추적 위치 · 알림을 JSONL 로 남길 폴더. 비우면 Src/logs, off 면 안 남김
HELPER_LOG_DIR=

# ── 이탈 판단 ──
DEVIATE_AFTER_SEC=3          # 말소리가 이 시간 동안 대본과 안 맞으면 이탈
